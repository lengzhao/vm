package main

import (
 __vmBytes "bytes"
 __vmBufio "bufio"
 __vmJSON "encoding/json"
 __vmFmt "fmt"
 __vmIO "io"
 __vmOS "os"
 __vmStrconv "strconv"
 __vmAPI "github.com/lengzhao/vm/contractapi"
)

func __vmConsumeGas(amount uint64) { __vmAPI.ConsumeGas(amount) }

type __vmCallRequest struct {
 Version int `json:"version"`
 Function string `json:"function"`
 Args []__vmJSON.RawMessage `json:"args"`
}

type __vmCallResponse struct {
 Version int `json:"version"`
 OK bool `json:"ok"`
 Result interface{} `json:"result,omitempty"`
 Code __vmAPI.ErrorCode `json:"code,omitempty"`
 Error string `json:"error,omitempty"`
 Gas uint64 `json:"gas"`
 Events []__vmAPI.Event `json:"events,omitempty"`
}

func __vmWriteResponse(resp __vmCallResponse) {
 if failure:=__vmAPI.CallFailure();resp.OK && failure!=nil {resp=__vmCallResponse{OK:false,Code:__vmAPI.CodeCallFailure,Error:failure.Error()}}
 resp.Version = __vmAPI.ProtocolVersion
 resp.Gas = __vmAPI.GasUsed()
 resp.Events = __vmAPI.DrainEvents()
 payload,err := __vmJSON.Marshal(resp)
 if err != nil {
  payload,_ = __vmJSON.Marshal(__vmCallResponse{Version:__vmAPI.ProtocolVersion,OK:false,Code:__vmAPI.CodeInvalidResult,Error:"cannot encode contract result: "+err.Error(),Gas:resp.Gas})
 }
 __vmFmt.Fprintln(__vmOS.Stdout,string(payload))
}

func __vmFail(code __vmAPI.ErrorCode, message string) {
 if message=="" { message=string(code) }
 __vmWriteResponse(__vmCallResponse{OK:false,Code:code,Error:message})
 __vmOS.Exit(1)
}

func __vmDecodeScalar[T any](raw __vmJSON.RawMessage)(T,error) {
 var value T
 if __vmBytes.Equal(__vmBytes.TrimSpace(raw),[]byte("null")){return value,__vmFmt.Errorf("null is not a scalar value")}
 err := __vmJSON.Unmarshal(raw,&value)
 return value,err
}

